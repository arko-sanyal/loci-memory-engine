#!/usr/bin/env python3
"""PostCompact hook: re-run recall.py so memory recalibration happens
automatically after compaction instead of requiring a manual query.

Stdin carries the PostCompact hook's own JSON payload; this hook doesn't
need any of its fields (the recall query is fixed to maximize CARD's
recall depth), so stdin is only drained, not parsed.

Installed by the LOCI Engine installer - see installer/templates/ in the
loci-memory-engine repo for the source of this file.
"""
import json
import subprocess
import sys

PYTHON = "{{PYTHON}}"
RECALL = "{{RECALL_PATH}}"
QUERY = "summarize and combine everything across all memory entries, overall"

sys.stdin.read()

try:
    result = subprocess.run(
        [PYTHON, RECALL, QUERY],
        capture_output=True,
        text=True,
        timeout=60,
    )
except Exception as exc:
    print(json.dumps({"systemMessage": f"Post-compact memory recall failed to run: {exc}"}))
    sys.exit(0)

if result.returncode != 0:
    print(json.dumps({
        "systemMessage": f"Post-compact memory recall failed (exit {result.returncode}): {result.stderr[:300]}",
    }))
    sys.exit(0)

output = result.stdout
entry_count = sum(1 for line in output.splitlines() if line.startswith("["))

print(json.dumps({
    "systemMessage": f"Memory reloaded post-compact: {entry_count} entries recalled via recall.py",
    "hookSpecificOutput": {
        "hookEventName": "PostCompact",
        "additionalContext": "Automatic post-compaction memory recalibration (recall.py):\n\n" + output,
    },
}))
